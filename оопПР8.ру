class PlayerProfileForm(tk.Toplevel):
    PHOTOS = ["Портретна фотографія", "Художня фотографія", "Третя фотографія"]

    def __init__(self, master):
        super().__init__(master)
        self.title("Анкета гравця")
        self.geometry("560x400+150+120")
        self.resizable(False, False)
        self.configure(bg=BG_FORM)

        self.next_idx = 0
        self.current_idx = None

        tk.Label(self, text="Анкета гравця «Монополії»", font=FONT_TITLE,
                 fg="purple", bg=BG_FORM).place(x=20, y=10)
        data = [
            "Ім'я гравця: Іван Петренко",
            "Група: ІС-21",
            "Фішка: Автомобіль",
            "Стартовий капітал: 1500 M$",
            "Улюблене поле: Вулиця Хрещатик",
        ]
        for i, line in enumerate(data):
            tk.Label(self, text=line, font=FONT_TEXT, bg=BG_FORM,
                     anchor="w").place(x=20, y=60 + i * 30, width=300)
        tk.Label(self, text="Стратегія: скуповувати транспортні "
                            "компанії та будувати готелі на «помаранчевих» вулицях.",
                 font=FONT_TEXT, bg=BG_FORM, wraplength=290, justify="left",
                 anchor="nw").place(x=20, y=215, width=300, height=70)

        self.images = [PhotoCanvas(self, paint_portrait),
                       PhotoCanvas(self, paint_art),
                       PhotoCanvas(self, paint_third)]
        self.img_x, self.img_y = 340, 55

        self.lbl_name = tk.Label(self, text="", font=("Times New Roman", 11, "italic"),
                                 bg=BG_FORM, fg="#4a148c")
        self.lbl_name.place(x=320, y=300, width=240)

        self.btn_next = tk.Button(self, text=self.PHOTOS[0], font=FONT_BTN,
                                  command=self.on_next)
        self.btn_next.place(x=20, y=320, width=200, height=32)
        self.btn_hide = tk.Button(self, text="Забрати фотографію", font=FONT_BTN,
                                  command=self.on_hide, state=tk.DISABLED)
        self.btn_hide.place(x=240, y=320, width=170, height=32)
        self.btn_hide.place_forget()

    def on_next(self):
        for img in self.images:
            img.hide()
        idx = self.next_idx
        self.images[idx].show(self.img_x, self.img_y)
        self.current_idx = idx
        self.lbl_name.config(text="Зараз: " + self.PHOTOS[idx])

        self.next_idx = (idx + 1) % len(self.PHOTOS)
        self.btn_next.config(text=self.PHOTOS[self.next_idx])

        self.btn_hide.place(x=240, y=320, width=170, height=32)
        self.btn_hide.config(state=tk.NORMAL)

    def on_hide(self):
        for img in self.images:
            img.hide()
        self.current_idx = None
        self.lbl_name.config(text="")
        self.btn_hide.config(state=tk.DISABLED)
        self.btn_hide.place_forget()
        self.btn_next.config(text=self.PHOTOS[self.next_idx])


class CurrencyExchangeForm(tk.Toplevel):
    ARROW_SELL = "⇒"
    ARROW_BUY = "⇐"

    def __init__(self, master):
        super().__init__(master)
        self.title("Обмін валюти — Банк «Монополії»")
        self.geometry("470x290+200+160")
        self.resizable(False, False)
        self.configure(bg="#fff8e1")
        bg = "#fff8e1"

        self.mode = tk.IntVar(value=2)
        self.rb_buy = tk.Radiobutton(self, text="Купівля M$", variable=self.mode,
                                     value=1, font=FONT_TEXT, bg=bg,
                                     command=self.rb_buy_click)
        self.rb_sell = tk.Radiobutton(self, text="Продаж M$", variable=self.mode,
                                      value=2, font=FONT_TEXT, bg=bg,
                                      command=self.rb_sell_click)
        self.rb_buy.place(x=20, y=15, width=190, height=28)
        self.rb_sell.place(x=260, y=15, width=190, height=28)

        tk.Label(self, text="Курс купівлі, грн за 1 M$:", font=FONT_TEXT, bg=bg,
                 anchor="w").place(x=20, y=60, width=190, height=28)
        tk.Label(self, text="Курс продажу, грн за 1 M$:", font=FONT_TEXT, bg=bg,
                 anchor="w").place(x=20, y=100, width=190, height=28)
        self.ed_buy = tk.Entry(self, font=FONT_TEXT, justify="right")
        self.ed_sell = tk.Entry(self, font=FONT_TEXT, justify="right")
        self.ed_buy.insert(0, "5")
        self.ed_sell.insert(0, "5.2")
        self.ed_buy.place(x=260, y=60, width=190, height=28)
        self.ed_sell.place(x=260, y=100, width=190, height=28)

        self.ed_sum = tk.Entry(self, font=FONT_TEXT, justify="right")
        self.ed_sum.insert(0, "20")
        self.ed_sum.place(x=20, y=150, width=190, height=32)
        self.lbl_arrow = tk.Label(self, text=self.ARROW_SELL, font=("Arial", 22, "bold"),
                                  fg="#2e7d32", bg=bg, cursor="hand2")
        self.lbl_arrow.place(x=215, y=146, width=40, height=40)
        self.lbl_arrow.bind("<Button-1>", self.arrow_click)
        self.result = tk.StringVar()
        self.ed_res = tk.Entry(self, font=FONT_TEXT, justify="right",
                               textvariable=self.result, state="readonly")
        self.ed_res.place(x=260, y=150, width=190, height=32)

        tk.Label(self, text="Сума, M$", font=("Times New Roman", 10, "italic"),
                 bg=bg).place(x=20, y=184, width=190)
        tk.Label(self, text="Результат, грн", font=("Times New Roman", 10, "italic"),
                 bg=bg).place(x=260, y=184, width=190)

        tk.Button(self, text="Обчислити", font=FONT_BTN,
                  command=self.calculate).place(x=20, y=225, width=130, height=34)
        tk.Button(self, text="Очистити", font=FONT_BTN,
                  command=self.clear).place(x=170, y=225, width=130, height=34)
        tk.Button(self, text="Вихід", font=FONT_BTN,
                  command=self.destroy).place(x=320, y=225, width=130, height=34)

        ToolTip(self.ed_sum, "Введіть суму в M$")
        ToolTip(self.ed_buy, "Введіть курс купівлі")
        ToolTip(self.ed_sell, "Введіть курс продажу")

        self.ed_sum.focus_set()

    def rb_sell_click(self):
        self.lbl_arrow.config(text=self.ARROW_SELL)
        self.ed_sum.focus_set()

    def rb_buy_click(self):
        self.lbl_arrow.config(text=self.ARROW_BUY)
        self.ed_sum.focus_set()

    def arrow_click(self, _event=None):
        if self.mode.get() == 1:
            self.mode.set(2)
            self.rb_sell_click()
        else:
            self.mode.set(1)
            self.rb_buy_click()

    def calculate(self):
        try:
            f1 = to_float(self.ed_buy.get())
            f2 = to_float(self.ed_sell.get())
            f3 = to_float(self.ed_sum.get())
        except ValueError:
            messagebox.showerror("Помилка", "Введіть коректні числа "
                                            "(допускається крапка або кома).", parent=self)
            return
        f4 = f1 * f3 if self.mode.get() == 1 else f2 * f3
        self.result.set(fmt(f4))

    def clear(self):
        self.ed_sum.delete(0, tk.END)
        self.result.set("")
        self.ed_sum.focus_set()


class DistanceForm(tk.Toplevel):
    KM_PER_MILE = 1.609344
    KM_PER_NAUTICAL = 1.852

    def __init__(self, master):
        super().__init__(master)
        self.title("Відстань між залізницями")
        self.geometry("400x330+250+200")
        self.resizable(False, False)
        bg = "#e3f2fd"
        self.configure(bg=bg)

        self.mode = tk.IntVar(value=1)
        tk.Radiobutton(self, text="милі → км", variable=self.mode, value=1,
                       font=FONT_TEXT, bg=bg).place(x=20, y=15, width=170)
        tk.Radiobutton(self, text="км → милі", variable=self.mode, value=2,
                       font=FONT_TEXT, bg=bg).place(x=210, y=15, width=170)

        self.group = tk.LabelFrame(self, text=" Тип милі ", font=FONT_TEXT, bg=bg)
        self.group.place(x=20, y=55, width=360, height=75)
        self.item_index = tk.IntVar(value=0)
        for i, name in enumerate(("Звичайна (1,609344 км)", "Морська (1,852 км)")):
            tk.Radiobutton(self.group, text=name, variable=self.item_index, value=i,
                           font=FONT_TEXT, bg=bg, anchor="w").pack(fill="x", padx=8)

        tk.Label(self, text="Значення:", font=FONT_TEXT, bg=bg,
                 anchor="w").place(x=20, y=150, width=100, height=28)
        self.ed_in = tk.Entry(self, font=FONT_TEXT, justify="right")
        self.ed_in.insert(0, "10")
        self.ed_in.place(x=200, y=150, width=180, height=28)
        tk.Label(self, text="Результат:", font=FONT_TEXT, bg=bg,
                 anchor="w").place(x=20, y=195, width=100, height=28)
        self.out = tk.StringVar()
        tk.Entry(self, font=FONT_TEXT, justify="right", textvariable=self.out,
                 state="readonly").place(x=200, y=195, width=180, height=28)

        tk.Button(self, text="Обчислити", font=FONT_BTN,
                  command=self.calculate).place(x=20, y=260, width=170, height=34)
        tk.Button(self, text="Вихід", font=FONT_BTN,
                  command=self.destroy).place(x=210, y=260, width=170, height=34)

    def calculate(self):
        try:
            value = to_float(self.ed_in.get())
        except ValueError:
            messagebox.showerror("Помилка", "Введіть коректне число.", parent=self)
            return
        k = self.KM_PER_MILE if self.item_index.get() == 0 else self.KM_PER_NAUTICAL
        self.out.set(fmt(value * k if self.mode.get() == 1 else value / k))


