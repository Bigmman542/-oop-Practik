        c.create_rectangle(0, 80 + i * 30, 200, 110 + i * 30, fill=col, outline="")
    c.create_oval(120, 20, 180, 80, fill="#fff176", outline="")
    c.create_rectangle(35, 150, 165, 185, fill="#c62828", outline="black")
    c.create_polygon(65, 150, 80, 125, 130, 125, 145, 150, fill="#ef5350", outline="black")
    c.create_oval(48, 175, 80, 207, fill="black")
    c.create_oval(120, 175, 152, 207, fill="black")
    c.create_text(100, 228, text="Фішка «Автомобіль»", fill="white", font=("Arial", 9))


