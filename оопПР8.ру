        self.geometry("460x330+100+80")
        self.resizable(False, False)
        self.configure(bg=BG_FORM)

        tk.Label(self, text="МОНОПОЛІЯ", font=("Times New Roman", 26, "bold"),
                 fg="#b71c1c", bg=BG_FORM).pack(pady=(18, 0))
        tk.Label(self, text="Лабораторна робота №8: віконний інтерфейс",
                 font=("Times New Roman", 12, "italic"), bg=BG_FORM).pack(pady=(0, 18))

