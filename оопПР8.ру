FONT_TITLE = ("Times New Roman", 16, "bold")
FONT_TEXT = ("Times New Roman", 12)
FONT_BTN = ("Times New Roman", 11, "bold")
BG_FORM = "#e8f5e9"


class ToolTip:

    def __init__(self, widget, text):
        self.widget, self.text, self.tip = widget, text, None
        widget.bind("<Enter>", self._show)
        widget.bind("<Leave>", self._hide)

    def _show(self, _event=None):
        x = self.widget.winfo_rootx() + 20
        y = self.widget.winfo_rooty() + self.widget.winfo_height() + 4
        self.tip = tk.Toplevel(self.widget)
        self.tip.wm_overrideredirect(True)
        self.tip.wm_geometry(f"+{x}+{y}")
        tk.Label(self.tip, text=self.text, bg="#ffffe0", relief="solid",
                 borderwidth=1, font=("Arial", 9)).pack()

    def _hide(self, _event=None):
        if self.tip:
            self.tip.destroy()
            self.tip = None


def to_float(text):
    return float(text.strip().replace(",", "."))


def fmt(value):
    return f"{value:.2f}".rstrip("0").rstrip(".")


class PhotoCanvas(tk.Canvas):
    W, H = 200, 240

    def __init__(self, master, painter):
        super().__init__(master, width=self.W, height=self.H,
                         highlightthickness=2, highlightbackground="#6a1b9a")
        painter(self)

    def show(self, x, y):
        self.place(x=x, y=y)

    def hide(self):
        self.place_forget()


