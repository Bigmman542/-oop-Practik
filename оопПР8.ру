    c.create_rectangle(0, 0, 200, 240, fill="#bbdefb", outline="")
    c.create_oval(55, 40, 145, 150, fill="#ffcc80", outline="black")
    c.create_arc(50, 30, 150, 120, start=0, extent=180, fill="#4e342e")
    c.create_oval(78, 85, 92, 99, fill="white")
    c.create_oval(108, 85, 122, 99, fill="white")
    c.create_oval(82, 89, 90, 97, fill="black")
    c.create_oval(112, 89, 120, 97, fill="black")
    c.create_arc(78, 100, 122, 140, start=200, extent=140, style="arc", width=3)
    c.create_rectangle(60, 150, 140, 240, fill="#1a237e", outline="")
    c.create_text(100, 225, text="Портрет", fill="white", font=("Arial", 9))
    c.create_rectangle(70, 8, 130, 38, fill="black")
    c.create_rectangle(55, 36, 145, 44, fill="black")


