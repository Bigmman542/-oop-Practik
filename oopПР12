def show_line_styles(self):
    for i in range(1, 8):
        name, dash = LINE_STYLES[i - 1]
        color = "" if name == "psClear" else "black"
        self.canvas3.create_line(0, i * 15, CW - 110, i * 15, dash=dash, fill=color)
        self.canvas3.create_text(CW - 100, i * 15, text=name, anchor="w")



def draw_sinus(self):
    prev = (0, CH // 2)
    for px in range(SW + 1):
        x = px * 4 * math.pi / SW
        y = math.sin(x)
        py = CH - (y + 1) * CH / 2
        put_pixel(self.canvas4, px, py, "black")
        self.canvas5.create_line(prev[0], prev[1], px, py)
        prev = (px, py)



def draw_man(self):
    c, x, r = self.canvas6, self.xpos, self.revers
    if self.num == 0:
        yhead = YPOS - H - HMEN
        c.create_line(x - H, YPOS, x, YPOS - H, x + H, YPOS, tags="man")
        c.create_line(x, YPOS - H, x, yhead, tags="man")
        c.create_line(x + r * H, yhead - H, x, yhead + 4,
                      x + r * H, yhead + H, tags="man")
        c.create_oval(x + r * H - RHEAD2, yhead - H - RHEAD2,
                      x + r * H + RHEAD2, yhead - H + RHEAD2, tags="man")
        c.create_oval(x + r * H - RHEAD2, yhead + H - RHEAD2,
                      x + r * H + RHEAD2, yhead + H + RHEAD2, tags="man")
        c.create_oval(x - RHEAD, yhead, x + RHEAD, yhead - 2 * RHEAD, tags="man")
        c.create_rectangle(x - RHEAD, yhead - 2 * RHEAD - 1,
                           x + RHEAD, yhead - 2 * RHEAD - 4, tags="man")
    else:
        yhead = YPOS - L - HMEN
        c.create_line(x, YPOS, x, yhead, tags="man")
        c.create_line(x, yhead + 4, x + r * L, yhead + 4, tags="man")
        c.create_oval(x + r * L - RHEAD2, yhead + 4 - RHEAD2,
                      x + r * L + RHEAD2, yhead + 4 + RHEAD2, tags="man")
        c.create_oval(x - RHEAD, yhead, x + RHEAD, yhead - 2 * RHEAD, tags="man")
        c.create_rectangle(x - H // 2, yhead - 2 * RHEAD - 1,
                           x + H // 2, yhead - 2 * RHEAD - 4, tags="man")



def draw_ground(self):
    self.canvas6.create_line(0, YPOS + 3, CW, YPOS + 3, width=4)



def on_timer(self):
    self.canvas6.delete("man")
    if self.xpos >= CW - H or self.xpos <= H:
        self.revers = -self.revers
    self.xpos = self.xpos + self.revers * H
    self.num = 1 - self.num
    self.draw_man()
    self.timer_id = self.after(500, self.on_timer)



def toggle_timer(self):
    if self.timer_id is None:
        self.timer_id = self.after(500, self.on_timer)
    else:
        self.after_cancel(self.timer_id)
        self.timer_id = None



def clear_canvas7(self):
    self.canvas7.delete("all")
    self.canvas7.config(bg="white")



def on_mouse_down7(self, event):
    X, Y = event.x, event.y
    sx, sy = random.randrange(100), random.randrange(100)
    color = f"#{(0x008000 + sx * sy) & 0xFFFFFF:06x}"
    outline, dash, width = [("black", None, 1), ("red", (4, 2), 1),
                            ("blue", None, 3)][self.rg4.get()]
    stipple = ["", "gray50", "gray25", "gray12"][self.rg3.get()]
    shape = self.rg2.get()
    if shape == 0:
        self.canvas7.create_rectangle(X, Y, X + sx, Y + sy, fill=color, stipple=stipple,
                                      outline=outline, dash=dash, width=width)
    elif shape == 1:
        self.canvas7.create_oval(X, Y, X + sx, Y + sy, fill=color, stipple=stipple,
                                 outline=outline, dash=dash, width=width)
    elif shape == 2:
        self.canvas7.create_text(X, Y, text="Графіка в Python", anchor="nw", fill=color)
    else:
        red = f"#{(0xFF0000 + sx * sy) & 0xFFFFFF:06x}"
        items = self.canvas7.find_overlapping(X, Y, X, Y)
        if items:
            self.canvas7.itemconfig(items[-1], fill=red, stipple="")
        else:
            self.canvas7.config(bg=red)



