def draw_pixels(self):
    a = ASTR_A
    cx, cy = CW // 2, CH // 2
    for i in range(181):
        px = int(a * math.cos(2 * math.pi * i / 180) ** 3)
        py = int(a * math.sin(2 * math.pi * i / 180) ** 3)
        put_pixel(self.canvas1, cx + px, cy + py, "blue")



def line_to(self, x, y):
    x0, y0 = self.pen_pos
    self.canvas1.create_line(x0, y0, x, y, fill="red")
    self.pen_pos = (x, y)


def draw_pen(self):
    a = ASTR_A
    cx, cy = CW // 2, CH // 2
    self.pen_pos = (cx, cy)
    for i in range(181):
        px = int(a * math.cos(2 * math.pi * i / 180) ** 3)
        py = int(a * math.sin(2 * math.pi * i / 180) ** 3)
        self.line_to(cx + px, cy + py)



def on_mouse_down(self, event):
    X, Y = event.x, event.y
    if self.mode.get() == 0:
        x = y = 0
        while x + y < 300:
            put_pixel(self.canvas1, x, y, "blue")
            x += 3
            y += 3
    else:
        self.line_to(X, Y)



def clear_canvas1(self):
    self.canvas1.delete("all")



